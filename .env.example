# ═══════════════════════════════════════════════════
# Pomera Task Manager — Environment Variables
# ═══════════════════════════════════════════════════
# Is file ko `.env` ke naam se copy karo aur values bharo.
# .env kabhi git me commit mat karna — .gitignore me daala hua hai.

# ── Database backend ─────────────────────────────────
# mysql  = Hostinger / cPanel wali MySQL (LIVE ke liye yahi)
# local  = koi DB nahi chahiye, data ek JSON file me (sirf dev/demo)
# pg     = PostgreSQL
# hybrid = FMS tables Google Sheets me, baaki Postgres me
# sheets = sab kuch Google Sheets me
DB_BACKEND=mysql

# ── MySQL (Hostinger) ────────────────────────────────
# hPanel → Databases → Management me ye values milti hain.
# LOCAL machine se connect karna ho to pehle hPanel → Databases →
# Remote MySQL me apna IP whitelist karna padta hai (warna connection refuse).
# Hostinger ke SERVER par app chale to host 'localhost' hi rehta hai.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=u563441929_pomera
MYSQL_PASSWORD=
MYSQL_DATABASE=u563441929_pomera
# Cloud MySQL (PlanetScale/Aiven) ho to true karo. Hostinger ke liye false.
MYSQL_SSL=false
# Ya sab ek line me (ye set ho to upar wali ignore ho jaati hain):
# MYSQL_URL=mysql://user:password@host:3306/dbname

# ── PostgreSQL (sirf DB_BACKEND=pg / hybrid ke liye) ──
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=pomera
PG_SSL=false

# ── Google Sheets (sirf DB_BACKEND=hybrid / sheets ke liye) ──
# Blank spreadsheet banao, service account ke saath Editor access do,
# aur URL se ID copy karo (.../spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=
# Service account key: project root me credentials.json rakho, ya poora
# JSON ek line me yahan paste karo (hosting ke liye):
# GOOGLE_CREDENTIALS={"type":"service_account", ...}

# ── App ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Lamba random string — session cookies isse sign hoti hain. ISE BADALNA ZAROORI HAI.
SESSION_SECRET=change_this_to_a_long_random_string
APP_URL=https://pomerataskmanager.com

# ── Email (Gmail SMTP) — OPTIONAL ────────────────────
# 2-Step Verification ON karke https://myaccount.google.com/apppasswords
# se 16-character App Password banao (normal Gmail password nahi chalega).
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Pomera Task Manager

# ── FMS file uploads → Google Drive — OPTIONAL ───────
# Khaali chhod do to files database me store hoti hain aur /f/<id> link milta hai.
DRIVE_UPLOAD_FOLDER_ID=
APPS_SCRIPT_UPLOAD_URL=
